  "graph_rules": {
    "detector_input": "photo / 127.5 - 1 resized to 192 x 192 (ResizeArea if the long edge > 1920, else ResizeBilinear; align_corners=True)",
    "person_rule": "detector channel 0: (tanh + 1) / 2 > 0.8; rows and columns with more than 3 person pixels; the human branch runs if rows + columns > 50",
    "human_branch": "box of the person rows and columns with a margin of 1/8 (box side > 0.33 of the photo) or 1/2; CropAndResize to 1920 x 1920 and AvgPool 5 x 5 VALID (long edge > 1920) or 640 x 640; ResizeBilinear to 224 (coarse U-Net); refine U-Net at 480 x 480 on the crop and the coarse map; alpha = ((tanh + 1) / 2)^2 * 255",
    "branch_rule": "human result if the human branch ran and its alpha sum / 255 / photo area > 0.1, else the object branch",
    "object_branch": "photo ResizeBilinear to 224 (stage 0 U-Net); box of the rows and columns with more than 5 pixels of (tanh + 1) / 2 > 0.8, margin 1/4; CropAndResize to 640 x 640, ResizeBilinear to 224 (stage 1 U-Net); refine U-Net at 640 x 640 on the crop and the stage 1 map; alpha = (tanh + 1) * 127.5",
    "output": "alpha ResizeBilinear (align_corners=True) from 480 or 640 to the box size in photo pixels, Pad to the photo; RGB = photo * (alpha > 0.001); RGBA"
  },
  "model_input": "input_image [H, W, 3] float32, RGB 0 to 255 (LoadImage of ModelScope)",
  "model_output": "rgba [H, W, 4] float32 (cond_3/Merge:0); alpha = channel 3 / 255",
